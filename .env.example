# OpenAI API (speech-to-text and conversation)
OPENAI_API_KEY=your-openai-api-key-here

# Amazon Polly (text-to-speech) does not use .env; it reads the default credentials from ~/.aws/credentials

# Your city, e.g. Berlin (for the weather forecast when no city is named; uses Open-Meteo, no API key needed)
PUPPIE_HOME_CITY=your-city-here

# Optional: who your Puppie is (its name and role), in the language it speaks.
# Remove the "#" in front of the next line and write your own. Without it, the default below is used.
# PUPPIE_PERSONA="Dein Name ist Puppie. Du bist ein freundlicher Alltagsbegleiter und unterhältst dich gern mit allen."

# Debug mode: 0 = off, 1 = on. With 1, every conversation is saved to log_puppie_conversation.csv
# and what was said appears in the log (journalctl). Keep it at 0 unless you are fixing a problem.
PUPPIE_DEBUG=0
