# OpenAI API (Chat / TTS)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# AWS (Polly) does not use .env; it reads the default credentials from ~/.aws/credentials

# Your city, e.g. Berlin (for the weather forecast when no city is named; uses Open-Meteo, no API key needed)
PUPPIE_HOME_CITY=your-city-here
