# OpenAI API (speech-to-text and conversation)
OPENAI_API_KEY=your-openai-api-key-here

# Amazon Polly (text-to-speech) does not use .env; it reads the default credentials from ~/.aws/credentials

# Optional: your city, for the weather forecast when no city is named (uses Open-Meteo, no API key needed).
# Remove the "#" in front of the next line and write your city. Without it, Puppie asks which city.
# PUPPIE_HOME_CITY=Berlin

# Optional: who your Puppie is (its name and role), in the language it speaks.
# Remove the "#" in front of the next line and write your own. Without it, the default below is used.
# PUPPIE_PERSONA="Dein Name ist Puppie. Du bist ein freundlicher Alltagsbegleiter und unterhältst dich gern mit allen."

# Optional: your Puppie's birthday as month-day (MM-DD). Puppie remembers it and is happy when the day comes.
# PUPPIE_BIRTHDAY=11-09

# Optional: the conversation model. gpt-5.4-nano (default) is the fastest and cheapest;
# gpt-5.4-mini gives smarter replies but answers a little more slowly and costs more.
# PUPPIE_GPT_MODEL=gpt-5.4-mini

# Optional: the language Puppie listens for (default de), e.g. en or ja.
# Leave it empty (PUPPIE_STT_LANGUAGE=) for automatic detection; short utterances may then be taken for another language.
# PUPPIE_STT_LANGUAGE=en

# Optional: speaker volume at start, from 0.0 to 1.0 (default 0.7)
# PUPPIE_VOLUME=0.5

# Optional: end the conversation after this many seconds without anyone speaking (default 180 = 3 minutes)
# PUPPIE_IDLE_TIMEOUT_SEC=60

# Debug mode: 0 = off, 1 = on. With 1, every conversation is saved to log_puppie_conversation.csv
# and what was said appears in the log (journalctl). Keep it at 0 unless you are fixing a problem.
PUPPIE_DEBUG=0
